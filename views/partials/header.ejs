<header class="app-header">
  <div class="container navbar">
    <a class="brand" href="/dashboard" aria-label="Página inicial do SalonTech">
      <img src="/img/favicon.jpeg" alt="Logo SalonTech" class="brand-logo">
      <span>Salon<span class="gradient-text">Tech</span></span>
    </a>
    <nav aria-label="Navegação principal">
      <ul class="nav-links" id="navLinks">
        <% if (user && ['admin', 'master'].includes(user.papel)) { %>
          <li><a href="/clientes">Clientes</a></li>
        <% } %>
        <li><a href="/agendamentos">Agendamentos</a></li>
        <li><a href="/servicos">Serviços</a></li>
        <% if (user && ['admin', 'master'].includes(user.papel)) { %>
          <li><a href="/equipe">Equipe</a></li>
        <% } %>
        <li><a href="/produtos">Produtos</a></li>
        <% if (user && ['admin', 'master'].includes(user.papel)) { %>
          <li><a href="/despesas">Despesas</a></li>
        <% } %>
        <li><a href="/pagamentos">Formas de pagamento</a></li>
        <% if (user && ['admin', 'master'].includes(user.papel)) { %>
          <li><a href="/financas">Finanças</a></li>
        <% } %>
      </ul>
    </nav>
    <div class="nav-controls">
      <span class="user-summary"><%= user.nome %> · <%= user.papel === 'master' ? 'Master' : user.papel === 'admin' ? 'Administrador' : 'Profissional de beleza' %></span>
      <% if (user && user.papel !== 'master') { %><a class="nav-account" href="/minha-conta">Minha conta</a><% } %>
      <form method="POST" action="/logout">
        <button class="nav-logout" type="submit">Sair</button>
      </form>
    </div>
  </div>
</header>
