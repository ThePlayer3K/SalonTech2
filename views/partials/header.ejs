<%
  const canManage = user && ['admin', 'master'].includes(user.papel);
  const roleLabel = user.papel === 'master' ? 'Master'
    : user.papel === 'admin' ? 'Administrador' : 'Profissional de beleza';
%>
<header class="app-header">
  <div class="container navbar">
    <a class="brand" href="/dashboard" aria-label="Página inicial do SalonTech">
      <img src="/img/favicon.jpeg" alt="Logo SalonTech" class="brand-logo">
      <span>Salon<span class="gradient-text">Tech</span></span>
    </a>
    <button class="mobile-menu-btn" id="mobileMenuBtn" type="button" aria-expanded="false" aria-controls="navMenu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <span>Menu</span>
    </button>
    <div class="nav-menu" id="navMenu">
      <nav aria-label="Navegação principal">
        <ul class="nav-links" id="navLinks">
          <% if (canManage) { %>
            <li><a href="/clientes">Clientes</a></li>
          <% } %>
          <li><a href="/agendamentos">Agendamentos</a></li>
          <li><a href="/servicos">Serviços</a></li>
          <% if (canManage) { %>
            <li><a href="/equipe">Equipe</a></li>
          <% } %>
          <li><a href="/produtos">Produtos</a></li>
          <% if (canManage) { %>
            <li><a href="/despesas">Despesas</a></li>
          <% } %>
          <li><a href="/pagamentos">Formas de pagamento</a></li>
          <% if (canManage) { %>
            <li><a href="/financas">Finanças</a></li>
          <% } %>
        </ul>
      </nav>
      <div class="nav-controls">
        <span class="user-summary"><%= user.nome %> · <%= roleLabel %></span>
        <% if (user && user.papel !== 'master') { %>
          <a class="nav-account" href="/minha-conta">Minha conta</a>
        <% } %>
        <div class="nav-session-actions">
          <% if (typeof showThemeToggle !== 'undefined' && showThemeToggle) { %>
            <button class="nav-action theme-toggle" type="button" data-theme-toggle aria-pressed="false" title="Ativar o modo escuro"><span aria-hidden="true">☾</span> Modo escuro</button>
          <% } %>
          <form method="POST" action="/logout">
            <button class="nav-logout" type="submit">Sair</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</header>
