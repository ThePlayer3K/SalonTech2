<form class="team-form catalog-form despesa-form" method="POST" action="<%= action %>">
  <div class="team-form-grid">
    <div class="field"><label for="<%= prefix %>-descricao">Descrição</label><input id="<%= prefix %>-descricao" name="descricao" required maxlength="120" value="<%= despesa.descricao || '' %>"></div>
    <div class="field"><label for="<%= prefix %>-valor">Valor (R$)</label><input id="<%= prefix %>-valor" name="valor" inputmode="decimal" required maxlength="15" placeholder="0,00" value="<%= despesa.valor ?? '' %>"></div>
    <div class="field">
      <label for="<%= prefix %>-tipo">Tipo</label>
      <select id="<%= prefix %>-tipo" name="tipo" required>
        <option value="">Selecione o tipo</option>
        <option value="fixo" <%= despesa.tipo === 'fixo' ? 'selected' : '' %>>Fixo</option>
        <option value="variavel" <%= despesa.tipo === 'variavel' ? 'selected' : '' %>>Variável</option>
      </select>
    </div>
    <div class="field"><label for="<%= prefix %>-data">Data</label><input id="<%= prefix %>-data" name="data" type="date" required min="0001-01-01" max="9999-12-31" value="<%= despesa.data || '' %>"></div>
  </div>
  <button class="btn btn-primary" type="submit"><%= action === '/despesas' ? 'Cadastrar despesa' : 'Salvar alterações' %></button>
</form>
