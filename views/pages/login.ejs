<%- include('../partials/head', { title, bodyClass: 'login-page' }) %>
<main class="auth-shell" aria-labelledby="authTitle">
  <section class="auth-panel">
    <a class="auth-brand" href="/login" aria-label="SalonTech">
      <img src="/img/favicon.jpeg" alt="Logo SalonTech" class="auth-logo">
      <span>Salon<span class="gradient-text">Tech</span></span>
    </a>
    <div class="auth-copy">
      <span class="section-kicker">Acesso interno</span>
      <h1 id="authTitle">Entrar no sistema</h1>
      <p>Gestão de clientes, agenda, equipe, serviços e produtos usados no salão.</p>
    </div>
    <form class="auth-form" method="POST" action="/login">
      <div class="field">
        <label for="login">Usuário</label>
        <input id="login" name="login" type="text" required autocomplete="username" placeholder="Nome do usuário" value="<%= login %>">
      </div>
      <div class="field">
        <label for="senha">Senha</label>
        <input id="senha" name="senha" type="password" required autocomplete="current-password" placeholder="Sua senha">
      </div>
      <% if (error) { %><p class="auth-status error" role="alert"><%= error %></p><% } %>
      <button class="btn btn-primary" type="submit">Entrar</button>
    </form>
    <p class="auth-note">Não há cadastro público. Contas de profissionais são criadas pelo administrador.</p>
  </section>
</main>
</body>
</html>
