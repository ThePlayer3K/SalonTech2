<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { user }) %>
<main id="conteudo">
  <section class="dashboard-hero">
    <div class="container">
      <span class="section-kicker">Painel do SalonTech</span>
      <h1>Olá, <%= user.nome %>.</h1>
      <p class="dashboard-lead">Seu acesso está configurado como <strong><%= admin ? 'Administrador' : 'Profissional de linha de frente' %></strong>.</p>
      <span class="role-badge <%= admin ? 'role-admin' : 'role-profissional' %>"><%= admin ? 'Administrador' : 'Profissional de linha de frente' %></span>
    </div>
  </section>
  <section class="container dashboard-section" aria-labelledby="modulesTitle">
    <div class="section-header">
      <div><span class="section-kicker">Acesso rápido</span><h2 id="modulesTitle">Módulos disponíveis</h2></div>
      <p><%= admin ? 'Visão geral e gerenciamento do salão.' : 'Visão pessoal dos seus atendimentos e serviços.' %></p>
    </div>
    <div class="module-card-grid">
      <% cards.forEach((card) => { %>
        <a class="module-card" href="<%= card.href %>">
          <span class="module-card-arrow">→</span>
          <h3><%= card.label %></h3>
          <p><%= card.description %></p>
        </a>
      <% }) %>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
