<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { user }) %>
<%
  const administradorMaster = user.papel === 'master';
  const administrador = user.papel === 'admin';

  function nomeDoPerfil(papel) {
    if (papel === 'master') return 'Administrador master';
    if (papel === 'admin') return 'Administrador';
    return 'Profissional de beleza';
  }
%>
<main id="conteudo">
  <section class="container team-section">
    <%- include('../partials/voltar-inicio') %>
    <span class="section-kicker"><%= selfOnly ? 'Acesso pessoal' : 'Funcionários e contas' %></span>
    <h1><%= selfOnly ? 'Minha conta' : 'Equipe e usuários' %></h1>
    <p class="team-intro">Cada funcionário possui uma conta vinculada. O login pode ser consultado; senhas são armazenadas protegidas e só podem ser redefinidas.</p>

    <% if (!selfOnly) { %>
      <details class="team-create" open>
        <summary>Adicionar funcionário</summary>
        <%- include('../partials/equipe-form', {
          person: null,
          action: '/equipe',
          selfOnly: false
        }) %>
      </details>
    <% } %>

    <div class="team-list">
      <% people.forEach((person) => { %>
        <%
          const contaProtegida = person.papel === 'master';
          const propriaConta = Number(person.usuario_id) === Number(user.id);
          const podeEditar = selfOnly || administradorMaster
            || (administrador && (person.papel !== 'admin' || propriaConta));
          const podeExcluir = !selfOnly && (administradorMaster
            || (administrador && person.papel !== 'admin'));
          const classePerfil = person.papel === 'profissional' ? 'role-profissional' : 'role-admin';
        %>
        <article class="team-card">
          <div class="team-card-heading">
            <div>
              <h2><%= person.nome %></h2>
              <p>Usuário: <strong><%= person.login %></strong></p>
            </div>
            <span class="role-badge <%= classePerfil %>"><%= nomeDoPerfil(person.papel) %></span>
          </div>
          <% if (contaProtegida) { %>
            <p class="team-locked">Conta protegida pelo ambiente. Não é possível alterar credenciais ou excluir este usuário.</p>
          <% } else { %>
            <% if (podeEditar) { %>
              <details class="team-edit" <%= selfOnly ? 'open' : '' %>>
                <summary><%= selfOnly ? 'Editar meus dados e credenciais' : 'Editar funcionário e credenciais' %></summary>
                <%- include('../partials/equipe-form', {
                  person,
                  action: selfOnly ? '/minha-conta' : `/equipe/${person.usuario_id}`,
                  selfOnly
                }) %>
              </details>
            <% } else { %>
              <p class="team-locked">Somente o Administrador master pode gerenciar outras contas de Administrador.</p>
            <% } %>
            <% if (podeExcluir) { %>
              <form
                method="POST"
                action="/equipe/<%= person.usuario_id %>/excluir"
                data-confirm="Excluir funcionário e usuário? Esta ação não pode ser desfeita."
              >
                <button class="mini-btn danger" type="submit">Excluir funcionário e usuário</button>
              </form>
            <% } %>
          <% } %>
        </article>
      <% }) %>
      <% if (!people.length) { %>
        <p class="empty-state">Nenhum funcionário cadastrado.</p>
      <% } %>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
