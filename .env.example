# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL do Render
# Use a External Database URL para executar scripts na sua máquina.
# No Web Service do Render, use a Internal Database URL.
DATABASE_URL=url_postgre_do_render

DB_SSL=true

# Sessão
SESSION_SECRET=troque_por_uma_string_longa_e_aleatoria
SESSION_MAX_AGE_HOURS=8

# Administrador master do sistema. O login será ADMIN_NAME.
ADMIN_NAME=Administrador
ADMIN_PASSWORD=123
