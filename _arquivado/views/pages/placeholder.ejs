<%- include('../partials/head', { title }) %>
<%- include('../partials/header', { user }) %>
<main id="conteudo">
  <section class="container placeholder-section">
    <span class="section-kicker">Próximo commit</span>
    <h1><%= resourceLabel %></h1>
    <div class="placeholder-card">
      <h2>Em breve</h2>
